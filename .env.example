# Copie para .env.local e preencha. Na Vercel, cadastre as mesmas variáveis
# em Project Settings > Environment Variables (menos as SEED_*).

# Neon: Dashboard > Connect > connection string (use a "pooled", com -pooler no host)
DATABASE_URL="postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# Gere com: npx auth secret   (ou: openssl rand -base64 32)
BETTER_AUTH_SECRET=""

# URL pública do app. Local: http://localhost:3000 | Vercel: https://seu-dominio
BETTER_AUTH_URL="http://localhost:3000"

# Storage de arquivos (CDN na KingHost, veja cdn/README.md). Opcionais: sem as
# duas, o envio de arquivos fica desligado. O secret é o mesmo do cdn/config.php.
# MEDIA_CDN_URL é a pasta onde ficam o upload.php e a uploads/.
# Gere o secret com: openssl rand -base64 48
MEDIA_CDN_URL=""            # ex.: https://cdn.doubleone.com.br
MEDIA_SIGNING_SECRET=""

# Tempo real (Worker no Cloudflare, veja realtime/README.md). Opcionais: sem as
# duas, notificações e chat se atualizam de tempos em tempos, sem websocket.
# O secret é o mesmo do Worker (wrangler secret put REALTIME_SECRET).
# Gere com: openssl rand -base64 48
REALTIME_URL=""             # ex.: https://workboard-realtime.sua-conta.workers.dev
REALTIME_SECRET=""

# Cofre de senhas dos clientes (AES-256-GCM). Opcional: sem ela, o cofre fica
# desligado. Gere com: openssl rand -base64 32
# Guarde uma cópia segura: perder ou trocar a chave torna as senhas salvas ilegíveis.
VAULT_ENCRYPTION_KEY=""

# E-mails por SMTP (acesso de usuário novo e links de nova senha). Opcionais: sem
# SMTP_HOST e SMTP_FROM, em desenvolvimento os e-mails só aparecem no terminal e,
# em produção, o envio fica desligado. Use os dados de SMTP do provedor do e-mail
# (na KingHost, no painel de e-mails) e uma conta do domínio; o remetente precisa
# ser essa conta, senão o provedor recusa ou o e-mail cai no spam.
# Teste com: npm run email:check -- voce@doubleone.com.br
SMTP_HOST=""                # ex.: smtp.seudominio.com.br
SMTP_PORT=""                # padrão 587 (STARTTLS); 465 = TLS direto
SMTP_SECURE=""              # "true" força TLS direto; vazio decide pela porta
SMTP_USER=""                # ex.: workboard@doubleone.com.br
SMTP_PASSWORD=""
SMTP_FROM=""                # ex.: Workboard <workboard@doubleone.com.br>

# Só em desenvolvimento (npm run dev): finge que hoje é esta data na saudação do
# header, para conferir as datas especiais (Halloween, Natal, Ano Novo). Ex.: 2026-10-31.
# Em produção é ignorada.
GREETING_PREVIEW_DATE=""

# Usadas só pelo `npm run db:seed` (admin@doubleone.com.br)
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Administrador"
