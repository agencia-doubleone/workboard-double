# Copie para .env.local e preencha. Na Vercel, cadastre as mesmas variáveis
# em Project Settings > Environment Variables (menos as SEED_*).

# Neon: Dashboard > Connect > connection string (use a "pooled", com -pooler no host)
DATABASE_URL="postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# Gere com: npx auth secret   (ou: openssl rand -base64 32)
BETTER_AUTH_SECRET=""

# URL pública do app. Local: http://localhost:3000 | Vercel: https://seu-dominio
BETTER_AUTH_URL="http://localhost:3000"

# Usadas só pelo `npm run db:seed` (admin@doubleone.com.br)
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Administrador"
